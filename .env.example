# ==============================================================================
# LinkedIn Growth Automation Assistant - Environment Configuration
# ==============================================================================
# NOTE: This application operates under a Human-in-the-Loop workflow.
# It does NOT automate browser actions or store LinkedIn credentials.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Frontend Configuration
VITE_API_URL=http://localhost:4000/api

# Database Connection (PostgreSQL or SQLite for quick local development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkedin_growth?schema=public

# AI Provider Configuration (Options: 'mock' | 'openai' | 'gemini' | 'anthropic')
# Default is 'mock' which generates high-quality deterministic engineering templates without requiring an API key.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Log Level (debug, info, warn, error)
LOG_LEVEL=info
